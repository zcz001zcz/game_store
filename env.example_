APP_ENV=dev
APP_DEBUG=1
APP_PORT=8080

# APP_PORT exposes the API on the host only. Compose services always call api:8080.

POSTGRES_DB=game_store
POSTGRES_USER=game_store
POSTGRES_PASSWORD=game_store
DATABASE_DSN=pgsql:host=db;port=5432;dbname=game_store
DATABASE_USER=game_store
DATABASE_PASSWORD=game_store

PROVIDER_A_URL=http://api:8080/stubs/providers/a/issue
PROVIDER_B_URL=http://api:8080/stubs/providers/b/issue
PROVIDER_CONNECT_TIMEOUT_MS=300
PROVIDER_TIMEOUT_MS=800

QUEUE_POLL_MS=200
QUEUE_BASE_RETRY_MS=500
QUEUE_STALE_AFTER_SECONDS=5
RECOVERY_INTERVAL_SECONDS=15
RECOVERY_AFTER_SECONDS=30
RECOVERY_BATCH_SIZE=20
